# --- Lokale Entwicklung (Standard) -------------------------------------------
# Kein Key nötig. Voraussetzung: `ollama serve` läuft und das Modell ist gepullt.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Produktion (Vercel) ------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5   # günstig und für diese Aufgabe ausreichend;
#                                   # claude-sonnet-5 oder claude-opus-5 sind stärker
